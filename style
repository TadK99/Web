body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #fffaf0;
  color: #222;
  line-height: 1.5;
}

header {
  background: #ffcc00;
  padding: 15px 20px;
  border-bottom: 3px solid #222;
}

header h1 {
  margin: 0 0 10px 0;
}

nav a {
  margin-right: 15px;
  color: #222;
  font-weight: bold;
  text-decoration: none;
}

nav a:hover {
  text-decoration: underline;
}

section {
  max-width: 900px;
  margin: auto;
  padding: 30px 20px;
  border-bottom: 1px dashed #ccc;
}

.banniere {
  display: flex;
  gap: 20px;
  align-items: center;
  flex-wrap: wrap;
}

.image-bd {
  width: 200px;
  height: 150px;
  background: #eee;
  border: 2px solid #222;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bouton, button {
  background: #222;
  color: white;
  padding: 8px 15px;
  border: none;
  text-decoration: none;
  cursor: pointer;
  font-size: 15px;
}

.cartes, .chiffres, .liste-bd, .filtres {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.carte {
  padding: 15px 20px;
  background: white;
  border: 2px solid #222;
  color: #222;
  text-decoration: none;
  font-weight: bold;
}

.carte:hover {
  background: #ffcc00;
}

.chiffres div {
  background: white;
  border: 2px solid #222;
  padding: 10px 20px;
  text-align: center;
}

.chiffres strong {
  font-size: 25px;
}

.filtres {
  margin-bottom: 20px;
}

select, input, textarea {
  padding: 6px;
  font-size: 15px;
}

.bd {
  width: 250px;
  background: white;
  border: 2px solid #222;
  padding: 10px;
}

.bd .image-bd {
  width: 100%;
}

.bd p {
  font-size: 13px;
  color: #666;
}

.cache {
  display: none;
}

dt {
  font-weight: bold;
}

.quiz {
  background: white;
  border: 2px solid #222;
  padding: 15px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 400px;
  margin-bottom: 20px;
}

textarea {
  height: 80px;
}

footer {
  text-align: center;
  padding: 20px;
  background: #222;
  color: white;
}
